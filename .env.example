# Copy to .env and adjust. All values have defaults, so .env is optional.
# Note: values under `environment:` in docker-compose*.yml (e.g. DEVICE) take precedence over this file.

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
RESULT_EXPIRES_SECONDS=3600

# --- Uploads (shared volume between api and worker) ---
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=wav,mp3,flac,ogg,m4a

# --- Worker ---
# Number of Celery worker processes (all share the single inference service)
WORKER_CONCURRENCY=4
INFERENCE_URL=http://inference:9000
INFERENCE_TIMEOUT_SECONDS=60

# --- Inference service ---
# mock | avdnet
DETECTOR=mock
# cpu | cuda (set by compose per mode)
DEVICE=cpu
MODEL_WEIGHTS_PATH=/models/avdnet.pt
# Dynamic batching: run the model when MAX_BATCH_SIZE items are queued or MAX_BATCH_WAIT_MS has passed
MAX_BATCH_SIZE=16
MAX_BATCH_WAIT_MS=20
# Requests beyond this many queued clips are rejected with 503 (the worker retries)
MAX_QUEUE_SIZE=256

# Preprocessing: audio is resampled and cut into fixed-length clips (last one zero-padded)
SAMPLE_RATE=16000
CLIP_SECONDS=4.0
# A trailing piece shorter than this is dropped (it would be mostly padding)
MIN_TAIL_SECONDS=1.0

# Decision: a clip is fake if score >= CLIP_THRESHOLD;
# a file is fake if >= POSITIVE_THRESHOLD of its clips are fake
CLIP_THRESHOLD=0.5
POSITIVE_THRESHOLD=0.2
# Fail the whole file (503, retried) if more than this share of its clips fail
MAX_FAILED_CLIP_RATIO=0.1

# --- Mock detector ---
# Simulated latency = MOCK_BATCH_OVERHEAD + MOCK_PER_ITEM_DELAY * batch_size (shows the batching benefit)
MOCK_BATCH_OVERHEAD=0.5
MOCK_PER_ITEM_DELAY=0.05
MOCK_FAILURE_RATE=0.05

# --- Logging ---
LOG_LEVEL=INFO
